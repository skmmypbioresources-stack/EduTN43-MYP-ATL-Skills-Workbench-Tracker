{
  "entities": {
    "task_logs": {
      "title": "Task Log",
      "description": "Logged student ATL task execution and assessment results across classes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "academicYear": { "type": "string" },
        "term": { "type": "string" },
        "studentName": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "mypYear": { "type": "string" },
        "category": { "type": "string" },
        "cluster": { "type": "string" },
        "level": { "type": "string" },
        "taskTitle": { "type": "string" },
        "responses": { "type": "array" },
        "feedback": { "type": "object" },
        "studentReflection": { "type": "string" },
        "attemptNumber": { "type": "number" },
        "criteria": { "type": "array" },
        "strands": { "type": "array" },
        "assignedTaskId": { "type": "string" },
        "dueDate": { "type": "string" },
        "submissionStatus": { "type": "string" },
        "daysOverdue": { "type": "number" },
        "originalTask": { "type": "object" },
        "stimulusImages": { "type": "array" },
        "studentAttachments": { "type": "array" },
        "teacherEvaluation": { "type": "object" },
        "badgeAwarded": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date", "studentName", "subject", "cluster", "level"]
    },
    "assigned_tasks": {
      "title": "Assigned Task",
      "description": "Teacher-created common ATL tasks assigned to all students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "mypYear": { "type": "string" },
        "category": { "type": "string" },
        "cluster": { "type": "string" },
        "task": { "type": "object" },
        "teacherName": { "type": "string" },
        "createdAt": { "type": "string" },
        "academicYear": { "type": "string" },
        "term": { "type": "string" },
        "active": { "type": "boolean" },
        "criteria": { "type": "array" },
        "strands": { "type": "array" },
        "dueDate": { "type": "string" },
        "dueDaysPeriod": { "type": "number" },
        "stimulusImages": { "type": "array" },
        "sourceType": { "type": "string" }
      },
      "required": ["id", "title", "subject", "topic", "task", "createdAt"]
    }
  },
  "firestore": {
    "/task_logs/{logId}": {
      "schema": { "$ref": "#/entities/task_logs" },
      "description": "Student ATL task completion and evaluation logs"
    },
    "/assigned_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/assigned_tasks" },
      "description": "Common ATL tasks created and assigned by teachers"
    }
  }
}
